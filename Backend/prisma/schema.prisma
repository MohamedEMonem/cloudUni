generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}
// Enums
enum UserRole {
  Customer
  StoreOwner
  Admin
}

enum OrderStatus {
  Pending
  Shipped
  Delivered
  Cancelled
}

enum PaymentStatus {
  Pending
  Success
  Failed
}

enum ProductStatus {
  Active
  Inactive
}

enum TransactionStatus {
  Success
  Failure
}

enum PayableType {
  Order
  Subscription
}

enum StoreStatus {
  Pending
  Active
  Suspended
}

// Models
model User {
  id              String    @id @default(uuid()) @map("user_id") @db.Uuid
  name            String    @db.Char(50)
  email           String    @unique @db.VarChar(150)
  password        String    @db.VarChar(255)
  role            UserRole  @default(Customer)
  contactNumber   String?   @map("contact_number") @db.VarChar(20)
  profilePhotoUrl String?   @map("profile_photo_url") @db.VarChar(255)
  googleOauthId   String?   @map("google_oauth_id") @db.VarChar(255)
  isVerified      Boolean   @default(false) @map("is_verified")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamp(0)

  // Relations
  ownedStores      Store[]         @relation("StoreOwner")
  orders           Order[]
  reviews          Review[]
  cart             Cart?
  sentMessages     Message[]       @relation("MessageSender")
  receivedMessages Message[]       @relation("MessageReceiver")
  notifications    Notification[]
  employments      StoreEmployee[]

  @@map("User")
}

model Store {
  id              String      @id @default(uuid()) @map("store_id") @db.Uuid
  ownerId         String      @map("owner_id") @db.Uuid
  name            String      @db.Char(50) @unique
  subdomain       String      @unique @db.VarChar(150)
  status          StoreStatus
  description     String?     @db.Text
  logoUrl         String?     @map("logo_url") @db.Text
  coverBannerUrl  String?     @map("cover_banner_url") @db.Text
  businessAddress String?     @map("business_address") @db.Text
  vatNumber       String?     @map("vat_number") @db.VarChar(100)
  themeSettings   Json?       @map("theme_settings")
  createdAt       DateTime?   @default(now()) @map("created_at") @db.Timestamp(0)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamp(0)

  // Relations
  owner         User            @relation("StoreOwner", fields: [ownerId], references: [id])
  products      Product[]
  orders        Order[]
  subscriptions Subscription[]
  employees     StoreEmployee[]
  messages      Message[]

  @@map("Store")
}

model Plan {
  id       String  @id @default(uuid()) @map("plan_id") @db.Uuid
  name     String  @db.VarChar(100)
  price    Decimal @db.Decimal(10, 2)
  features Json

  // Relations
  subscriptions Subscription[]

  @@map("Plan")
}

model Subscription {
  id              String    @id @default(uuid()) @map("subscription_id") @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  planId          String    @map("plan_id") @db.Uuid
  status          String    @db.VarChar(50)
  nextBillingDate DateTime? @map("next_billing_date") @db.Timestamp(0)

  // Relations
  store Store @relation(fields: [storeId], references: [id])
  plan  Plan  @relation(fields: [planId], references: [id])

  @@map("Subscription")
}

model Category {
  id               String  @id @default(uuid()) @map("category_id") @db.Uuid
  name             String  @db.VarChar(100)
  parentCategoryId String? @map("parent_category_id") @db.Uuid

  // Relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("Category")
}

model Product {
  id            String        @id @default(uuid()) @map("product_id") @db.Uuid
  storeId       String        @map("store_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  title         String        @db.VarChar(150)
  description   String?       @db.Text
  price         Decimal       @db.Decimal(10, 2)
  stockQuantity Int           @default(0) @map("stock_quantity")
  status        ProductStatus @default(Active)
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamp(0)

  // Relations
  store      Store          @relation(fields: [storeId], references: [id])
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]

  @@map("Product")
}

model ProductImage {
  id        String @id @default(uuid()) @map("image_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  imageUrl  String @map("image_url") @db.VarChar(255)
  sortOrder Int?   @default(0) @map("sort_order")

  // Relations
  product Product @relation(fields: [productId], references: [id])

  @@map("ProductImage")
}

model Order {
  id              String        @id @default(uuid()) @map("order_id") @db.Uuid
  customerId      String        @map("customer_id") @db.Uuid
  storeId         String        @map("store_id") @db.Uuid
  status          OrderStatus   @default(Pending)
  shippingAddress Json?         @map("shipping_address")
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  shippingCost    Decimal?      @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  taxAmount       Decimal?      @default(0) @map("tax_amount") @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(Pending) @map("payment_status")
  createdAt       DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamp(0)

  // Relations
  customer   User        @relation(fields: [customerId], references: [id])
  store      Store       @relation(fields: [storeId], references: [id])
  orderItems OrderItem[]
  reviews    Review[]

  @@map("Orders")
}

model OrderItem {
  id              String  @id @default(uuid()) @map("order_item_id") @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  quantity        Int
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("OrderItem")
}

model Review {
  id            String    @id @default(uuid()) @map("review_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  rating        Int
  reviewText    String?   @map("review_text") @db.Text
  storeResponse String?   @map("store_response") @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  // Relations
  product  Product @relation(fields: [productId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id])

  @@map("Review")
}

model Cart {
  id         String    @id @default(uuid()) @map("cart_id") @db.Uuid
  customerId String    @unique @map("customer_id") @db.Uuid
  expiresAt  DateTime? @map("expires_at") @db.Timestamp(0)

  // Relations
  customer  User       @relation(fields: [customerId], references: [id])
  cartItems CartItem[]

  @@map("Cart")
}

model CartItem {
  id        String @id @default(uuid()) @map("cart_item_id") @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("CartItem")
}

model PaymentTransaction {
  id                   String            @id @default(uuid()) @map("transaction_id") @db.Uuid
  payableId            String            @map("payable_id") @db.Uuid
  payableType          PayableType       @map("payable_type")
  gatewayName          String?           @map("gateway_name") @db.VarChar(50)
  gatewayTransactionId String?           @map("gateway_transaction_id") @db.VarChar(100)
  amount               Decimal           @db.Decimal(10, 2)
  status               TransactionStatus @default(Success)
  createdAt            DateTime?         @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("PaymentTransaction")
}

model StoreEmployee {
  userId      String @map("user_id") @db.Uuid
  storeId     String @map("store_id") @db.Uuid
  permissions Json?

  // Relations
  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@id([userId, storeId])
  @@map("StoreEmployee")
}

model Message {
  id         String    @id @default(uuid()) @map("message_id") @db.Uuid
  senderId   String    @map("sender_id") @db.Uuid
  receiverId String    @map("receiver_id") @db.Uuid
  storeId    String?   @map("store_id") @db.Uuid
  content    String    @db.Text
  readStatus Boolean?  @default(false) @map("read_status")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  // Relations
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])
  receiver User   @relation("MessageReceiver", fields: [receiverId], references: [id])
  store    Store? @relation(fields: [storeId], references: [id])

  @@map("Message")
}

model Notification {
  id         String    @id @default(uuid()) @map("notification_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(50)
  content    String    @db.VarChar(50)
  readStatus Boolean?  @default(false) @map("read_status")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("Notification")
}

model StoreAnalytics {
  receiverId String @map("receiver_id") @db.Uuid

  @@map("StoreAnalytics")
  @@ignore
}
