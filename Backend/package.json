{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend of dokkan",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:ts": "tsx watch src/server.ts",
    "build": "tsc",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:clean": "docker compose down -v",
    "infra:FullClean": "docker system prune -a --volumes",
    "backend:up": "docker compose -f docker-compose.backend.yml -p dokkan_backend up -d --build",
    "backend:down": "docker compose -f docker-compose.backend.yml -p dokkan_backend down",
    "backend:logs": "docker compose -f docker-compose.backend.yml -p dokkan_backend logs -f",
    "backend:rebuild": "docker compose -f docker-compose.backend.yml -p dokkan_backend up -d --build --force-recreate",
    "backend:reset": "docker compose -f docker-compose.backend.yml -p dokkan_backend down -v",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "lint": "nx run-many -t lint --all",
    "lint:api": "nx lint api",
    "lint:fix": "nx run-many -t lint --all -- --fix",
    "lint:api:fix": "nx lint api -- --fix"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "handlebars": "^4.7.9",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.7",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12",
    "@aws-sdk/client-s3": "^3.1045.0"

  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.8.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "glob": "^10.4.5",
    "inflight": "npm:lru-cache@^11.0.1"
  }
}